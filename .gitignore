# dependencies and local state
node_modules/
.wrangler/
.dev.vars
*.tmp.mjs
shot-card.png

# Machine-specific: points npm at Git Bash on the owner's Windows machine.
# On Windows, see "Running the tests on Windows" in the README.
.npmrc

# Private: real LinkedIn posts by real people, with engagement numbers, and the
# documents that discuss them by name. The tests and the harness run without
# them and say what they skipped. See "Validation against a labelled corpus".
corpus.json
corpus-results.txt
corpus-scores.json
VALIDATION_REPORT.md

# A separate tool with its own data about named people. Not part of this product.
data/

# Local audit reports and agent tooling
.reconcilers/
.claude/

# Round 4 (see round4/README.md): real people's posts and the label lock.
round4/posts/*
!round4/posts/_example.txt
round4/lock.json

# Words the public page must never contain (see client.test.mjs).
.private-words
